# Passcode required to unlock /oficina (owner area). Client-side only — not real
# security, just a deterrent against random visitors. Change it here or in your
# Vercel project's Environment Variables, then redeploy.
VITE_OFICINA_PASSCODE=wdpdr2026

# --- Supabase (projeto "WD PDR", eu-west-1) ---
# Publicas por natureza: acabam dentro do bundle. A seguranca esta nas politicas
# RLS (supabase/migrations), nao no segredo destas chaves.
VITE_SUPABASE_URL=https://<o-teu-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NUNCA por aqui: a service_role key. Essa ignora todas as politicas RLS e so pode
# viver nos secrets das Edge Functions do Supabase.
